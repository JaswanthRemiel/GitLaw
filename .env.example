# ========================================================
# GitLaw Configuration
# ========================================================

# --- GitHub Authentication ---
# For GitHub App Mode (Probot):
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=development

# For CLI / GitHub Actions Mode:
GITHUB_TOKEN=ghp_your_github_token_here

# --- LLM Provider Selection ---
# Options: "gemini" | "openai" | "anthropic" | "mock"
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OpenAI / OpenAI-Compatible (Ollama, Groq, DeepSeek, Together AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Storage Settings ---
GITLAW_DB_PATH=.gitlaw/rules.sqlite

# --- Webhook Server Port ---
PORT=3000
